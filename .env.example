# Copy this file to .env for local development (netlify dev reads it).
# On Netlify, set the same names under Site configuration > Environment variables.
# NEVER commit .env and never put these values in anything under /public.

# Required. Create a key in Google AI Studio.
GEMINI_API_KEY=

# Required in practice. Model ids change over time - check the current list at
# https://ai.google.dev/gemini-api/docs/models and update this value when needed.
GEMINI_MODEL=gemini-3.8-flash

# Optional: restrict the AI features to people who know a shared code.
# If set, the site asks for it the first time someone generates a document.
# SOCIETY_ACCESS_CODE=

# Optional tuning
# GEMINI_TEMPERATURE=          # leave unset to use the model's default
# GEMINI_TIMEOUT_MS=24000      # keep below your Netlify function time limit
# RATE_LIMIT_PER_10_MIN=15     # best-effort per-IP limit

# Required on Netlify: durable server-side request limit across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REQUIRE_DISTRIBUTED_RATE_LIMIT=true
# SOCIETY_RATE_LIMIT_NAMESPACE=my-society
